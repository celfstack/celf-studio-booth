# Required on Vercel: connect an Upstash Redis store to this project.
# These variables are server-only. Never prefix them with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local development automatically uses .local/together.sqlite (never in production).

# Recommended for reliable live cameras across different networks.
# Cloudflare Realtime TURN key; credentials are generated server-side for one hour.
TURN_KEY_ID=
TURN_API_TOKEN=
